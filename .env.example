# Bolt PostgreSQL connection string. Configure this secret in Bolt, never commit its value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Authentication secrets and the single public production address.
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="https://pricingtool.bolt.host"
NEXTAUTH_URL="https://pricingtool.bolt.host"
NEXT_PUBLIC_APP_URL="https://pricingtool.bolt.host"
