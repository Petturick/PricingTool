# PrySight database
# Bolt reserves custom secret names that start with SUPABASE_. Use these names in Bolt.
# Supported: paste the exact pooler URL from Supabase Connect.
PRICING_DATABASE_URL=

# Recommended for Bolt: set the password here. It overrides a stale password in
# PRICING_DATABASE_URL while retaining the assigned Supabase pooler host.
PRICING_DB_PROJECT_ID=xmedaatjwxkmwkjmwuuz
PRICING_DB_REGION=eu-west-2
PRICING_DB_PASSWORD=
PRICING_DB_POOLER_HOST=
PRICING_DB_USER=postgres.xmedaatjwxkmwkjmwuuz
# The runtime enforces Supavisor session pooling on port 5432. Legacy
# PRICING_DB_POOLER_PORT and SUPABASE_DB_POOLER_PORT secrets are ignored.

# Legacy full PostgreSQL connection string fallback
DATABASE_URL=

# Application and Auth.js session signing
# Use a long random value in production. AUTH_SECRET is the Auth.js v5 name.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
PRICING_TOOL_BASE_URL=http://localhost:3000

# Supabase browser/API access when needed by frontend integrations
NEXT_PUBLIC_SUPABASE_URL=https://xmedaatjwxkmwkjmwuuz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pricing automation
# PRICE_MONITOR_API_KEY must use the same value in GitHub Actions and Bolt runtime.
PRICE_MONITOR_API_KEY=
DATA_FEED_API_KEY=
REPORT_API_KEY=
ALERT_WEBHOOK_URL=
REPORT_WEBHOOK_URL=

# Syntrx PIM connection
SYNTRX_SUPABASE_URL=
SYNTRX_SUPABASE_PUBLISHABLE_KEY=
SYNTRX_ENGELS_ORGANIZATION_ID=
